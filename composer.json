{
    "name": "ottosmops/pdftotext",
    "description": "Extract text from PDF files with pdftotext (poppler-utils)",
    "keywords": [
        "anton",
        "ottosmops",
        "pdftotext",
        "poppler",
        "pdf",
        "text extraction"
    ],
    "authors": [
        {
            "name": "ak",
            "email": "kraenzle@k-r.ch",
            "homepage": "https://www.k-r.ch"
        }
    ],
    "homepage": "https://github.com/ottosmops/pdftotext",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "symfony/process": "^5.4 || ^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0 || ^13.0"
    },
    "suggest": {
        "ext-mbstring": "Used by sanitizeUtf8() to replace invalid UTF-8 sequences with U+FFFD"
    },
    "autoload": {
        "psr-4": {
            "Ottosmops\\Pdftotext\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ottosmops\\Pdftotext\\Test\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
